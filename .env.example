# Copy this file to .env and replace each value with your own secret.
# Never commit or share .env.

FIREBASE_WEB_API_KEY=replace_with_your_firebase_web_api_key
ADMIN_EMAIL=replace_with_admin_email
ADMIN_PASSWORD=replace_with_a_strong_admin_password
SECRET_KEY=replace_with_a_long_random_secret

# Local Firebase Admin SDK key file:
FIREBASE_KEY=serviceAccountKey.json

# Optional settings:
# APP_TZ=Asia/Karachi
# KUMATI_UNIT_PRICE=1000
# APP_PASSWORD=
# FIREBASE_KEY_JSON=
